{
  "name": "pazzle-game",
  "version": "0.1.0",
  "description": "Puzzle game for Yandex Games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vk": "vite --mode vk",
    "build": "tsc --noEmit && vite build",
    "build:yandex": "npm run build",
    "build:vk": "tsc --noEmit && vite build --mode vk --outDir dist-vk",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "music:build": "node scripts/create-background-music.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
